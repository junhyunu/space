{
  "name": "spacelog",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w @spacelog/web",
    "build": "npm run build -w @spacelog/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @spacelog/web",
    "test": "node --test \"packages/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
